    {
      "id": "L-005",
      "title": "[OPT-CFG-02] World-writable chmod 777 / 0o777 permissions",
      "status": "approved",
      "created_at": "2026-11-27T21:43:12Z",
      "updated_at": "2026-11-27T21:43:13Z",
      "captured": {
        "bad_example": "chmod -R 777 /var/app/uploads\n",
        "desired_outcome": "Grant least-privilege permissions (such as 755 for executables or 644/600 for data and secrets) instead of world-writable 777.",
        "valid_neighbouring_case": "chmod 755 scripts/entrypoint.sh\n",
        "why_it_matters": "Agents sometimes reach for chmod 777 to bypass container permission errors quickly, but isolated ephemeral build scripts may occasionally have custom mount requirements.",
        "file_glob": "*.sh,*.bash,*.zsh,*.py,*Dockerfile*,Dockerfile*,*.dockerfile,*.yml,*.yaml",
        "source_context": "library:build-config-hygiene/OPT-CFG-02"
      },
      "proposal": {
        "layer": "deterministic_check",
        "severity": "error",
        "file_glob": "*.sh,*.bash,*.zsh,*.py,*Dockerfile*,Dockerfile*,*.dockerfile,*.yml,*.yaml",
        "pattern": "\\bchmod\\s+(?:-[A-Za-z]+\\s+)*0?777\\b|\\b0o777\\b",
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": null,
        "why_not_deterministic": null,
        "remediation": "Grant least-privilege permissions (such as 755 for executables or 644/600 for data and secrets) instead of world-writable 777.",
        "retirement_trigger": "Retire once infrastructure policy linters (Checkov, Trivy, ShellCheck) enforce least-privilege modes in CI.",
        "proposal_sha256": "b0e6f7441cd4bdcde3a222ba9131a8f0a8ab1f565a8df7f56c1a61e3ae545f6a"
      },
