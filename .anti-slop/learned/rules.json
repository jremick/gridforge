    {
      "id": "L-004",
      "title": "[OPT-CFG-01] Floating :latest base image tag in Dockerfile",
      "status": "approved",
      "created_at": "2026-11-27T21:43:12Z",
      "updated_at": "2026-11-27T21:43:12Z",
      "captured": {
        "bad_example": "FROM python:latest\n",
        "desired_outcome": "Pin an explicit version tag or image digest (for example, FROM python:3.12-slim or @sha256:...) for reproducible builds.",
        "valid_neighbouring_case": "FROM python:3.12-slim\n",
        "why_it_matters": "Disposable local dev containers occasionally track :latest intentionally; kept opt-in so non-Docker or scratch dev setups are unaffected.",
        "file_glob": "*Dockerfile*,Dockerfile*,*.dockerfile",
        "source_context": "library:build-config-hygiene/OPT-CFG-01"
      },
      "proposal": {
        "layer": "deterministic_check",
        "severity": "warning",
        "file_glob": "*Dockerfile*,Dockerfile*,*.dockerfile",
        "pattern": "(?i)^\\s*FROM\\s+(?:--platform=\\S+\\s+)?[^\\s@]+:latest(?:\\s|$)",
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": null,
        "why_not_deterministic": null,
        "remediation": "Pin an explicit version tag or image digest (for example, FROM python:3.12-slim or @sha256:...) for reproducible builds.",
        "retirement_trigger": "Retire once Hadolint DL3007 or container policy checks enforce pinned base images in CI.",
