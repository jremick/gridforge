    {
      "id": "L-007",
      "title": "[OPT-VER-01] Require live end-to-end or real-artifact verification before claiming done",
      "status": "approved",
      "created_at": "2026-11-27T21:43:13Z",
      "updated_at": "2026-11-27T21:43:13Z",
      "captured": {
        "bad_example": "Updated the checkout endpoint and all 4 mocked unit tests passed; feature is verified and ready.\n",
        "desired_outcome": "Run a real CLI/HTTP/artifact smoke check after unit tests and cite the exact command and observed output.",
        "valid_neighbouring_case": "Ran pytest (12 passed) and posted a real fixture webhook to the local server (HTTP 200, verified balance_due_cents=1106).\n",
        "why_it_matters": "Pure libraries or air-gapped CI sandboxes may lack runnable live endpoints, whereas app/API/CLI repositories benefit from explicit live-artifact verification.",
        "file_glob": "*",
        "source_context": "library:verification-proof/OPT-VER-01"
      },
      "proposal": {
        "layer": "prompt_rule",
        "severity": "warning",
        "file_glob": "*",
        "pattern": null,
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": "Before claiming completion on an app, API, or CLI change, execute a real end-to-end command, live HTTP/CLI check, or real-artifact test and report the observed output. Do not rely solely on heavily mocked unit tests as proof of behavior.",
        "why_not_deterministic": "Static diff scanners cannot determine whether a given repo has a runnable local server, CLI entrypoint, or sandbox environment capable of live end-to-end execution.",
        "remediation": "Run a real CLI/HTTP/artifact smoke check after unit tests and cite the exact command and observed output.",
        "retirement_trigger": "Retire once CI integration smoke checks and diff-scoped mutation testing automatically verify changed behavior.",
        "proposal_sha256": "1f27ffdd4e076ae358ad64812672d9ebd2db4733a24e878d7e3747005d907dd1"
      },
      "verification": {
        "verified_at": "2026-11-27T21:43:13Z",
