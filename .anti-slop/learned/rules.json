    {
      "id": "L-001",
      "title": "[OPT-SEC-01] Python subprocess call with shell=True",
      "status": "approved",
      "created_at": "2026-11-27T21:43:12Z",
      "updated_at": "2026-11-27T21:43:12Z",
      "captured": {
        "bad_example": "subprocess.run(f\"tar -czf {archive} {src}\", shell=True, check=True)\n",
        "desired_outcome": "Pass an argv list with shell=False (the default) so untrusted inputs cannot trigger shell injection.",
        "valid_neighbouring_case": "subprocess.run([\"tar\", \"-czf\", archive, src], shell=False, check=True)\n",
        "why_it_matters": "Kept opt-in as a focused guard complementary to full SAST; build/ops wrapper repos sometimes invoke shell pipelines intentionally.",
        "file_glob": "*.py",
        "source_context": "library:security-boundaries/OPT-SEC-01"
      },
      "proposal": {
        "layer": "deterministic_check",
        "severity": "error",
        "file_glob": "*.py",
        "pattern": "\\bsubprocess\\.(?:run|Popen|call|check_call|check_output)\\s*\\([^\\n]*\\bshell\\s*=\\s*True\\b",
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": null,
        "why_not_deterministic": null,
        "remediation": "Pass an argv list with shell=False (the default) so untrusted inputs cannot trigger shell injection.",
        "retirement_trigger": "Retire if repo CI already enforces Bandit B602 or Semgrep subprocess-shell rules on every PR.",
        "proposal_sha256": "e7723fd07f802a1e50f8692745adca005c83984be288b5ab942755c457c8272e"
      },
      "verification": {
        "verified_at": "2026-11-27T21:43:12Z",
