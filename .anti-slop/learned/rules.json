    {
      "id": "L-003",
      "title": "[OPT-SEC-03] Dynamic eval() or exec() in production Python",
      "status": "approved",
      "created_at": "2026-11-27T21:43:12Z",
      "updated_at": "2026-11-27T21:43:12Z",
      "captured": {
        "bad_example": "parsed = eval(user_payload)\n",
        "desired_outcome": "Replace eval()/exec() with ast.literal_eval(), json.loads(), or an explicit dispatch table.",
        "valid_neighbouring_case": "parsed = ast.literal_eval(user_payload)\n",
        "why_it_matters": "Code generators, REPL harnesses, and plugin loaders may legitimately use exec(); kept opt-in to preserve low default false positives.",
        "file_glob": "*.py",
        "source_context": "library:security-boundaries/OPT-SEC-03"
      },
      "proposal": {
        "layer": "deterministic_check",
        "severity": "error",
        "file_glob": "*.py",
        "pattern": "(?<![.\\w])(?:eval|exec)\\s*\\(",
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": null,
        "why_not_deterministic": null,
        "remediation": "Replace eval()/exec() with ast.literal_eval(), json.loads(), or an explicit dispatch table.",
        "retirement_trigger": "Retire once Bandit B307/B102 or Ruff S307/S102 enforces this rule in CI.",
