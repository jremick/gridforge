    {
      "id": "L-006",
      "title": "[OPT-NET-01] Python HTTP call without explicit timeout",
      "status": "approved",
      "created_at": "2026-11-27T21:43:13Z",
      "updated_at": "2026-11-27T21:43:13Z",
      "captured": {
        "bad_example": "resp = requests.get(\"https://api.example.com/v1/health\")\n",
        "desired_outcome": "Pass an explicit timeout=... argument (for example, timeout=10 or timeout=(3, 10)) so outbound requests fail fast instead of hanging indefinitely.",
        "valid_neighbouring_case": "resp = requests.get(\"https://api.example.com/v1/health\", timeout=10)\n",
        "why_it_matters": "Internal one-off scripts, local fixture servers, or repositories wrapping a custom HTTPAdapter with default timeouts may intentionally omit per-call timeout arguments.",
        "file_glob": "*.py",
        "source_context": "library:network-timeouts/OPT-NET-01"
      },
      "proposal": {
        "layer": "deterministic_check",
        "severity": "warning",
        "file_glob": "*.py",
        "pattern": "\\b(?:requests\\.(?:get|post|put|patch|delete|head|options|request)|urllib\\.request\\.urlopen)\\s*\\((?![^\\n]*\\btimeout\\s*=)[^()\\n]*\\)",
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": null,
        "why_not_deterministic": null,
        "remediation": "Pass an explicit timeout=... argument (for example, timeout=10 or timeout=(3, 10)) so outbound requests fail fast instead of hanging indefinitely.",
        "retirement_trigger": "Retire once Ruff S113 / Bandit B113 or a project-wide HTTP client wrapper enforces timeouts in CI.",
        "proposal_sha256": "3f9c1d396b551a7de8155377b84106a12b40806bf6222783c1148cd8299b6103"
      },
      "verification": {
        "verified_at": "2026-11-27T21:43:13Z",
