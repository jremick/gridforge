    {
      "id": "L-002",
      "title": "[OPT-SEC-02] Unsafe yaml.load() without SafeLoader",
      "status": "approved",
      "created_at": "2026-11-27T21:43:12Z",
      "updated_at": "2026-11-27T21:43:12Z",
      "captured": {
        "bad_example": "config = yaml.load(raw_text)\n",
        "desired_outcome": "Use yaml.safe_load(...) or pass Loader=yaml.SafeLoader to prevent arbitrary object deserialization.",
        "valid_neighbouring_case": "config = yaml.load(raw_text, Loader=yaml.SafeLoader)\n",
        "why_it_matters": "Only relevant to Python repos using PyYAML; kept optional so non-YAML projects and dedicated SAST pipelines avoid redundant rules.",
        "file_glob": "*.py",
        "source_context": "library:security-boundaries/OPT-SEC-02"
      },
      "proposal": {
        "layer": "deterministic_check",
        "severity": "error",
        "file_glob": "*.py",
        "pattern": "\\byaml\\.load\\s*\\((?![^\\n]*(?:SafeLoader|CSafeLoader|BaseLoader|CBaseLoader))[^()\\n]*\\)",
        "match_mode": "line",
        "canonical_path": null,
        "rule_text": null,
        "why_not_deterministic": null,
        "remediation": "Use yaml.safe_load(...) or pass Loader=yaml.SafeLoader to prevent arbitrary object deserialization.",
        "retirement_trigger": "Retire once Ruff S506 / Bandit B506 or PyYAML removal makes this check redundant.",
        "proposal_sha256": "ff7fa8779513d145219fe3e72c459478f5f8d019059874dd56ed22c119637cf6"
