{
  "name": "gridforge-web",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:mcp-app": "vite build --config vite.mcp-app.config.ts",
    "preview": "vite preview --port 4173",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:compose": "node --experimental-strip-types --test tests/copy-cli.compose.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "maplibre-gl": "^6.19.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
